<?xml version="1.0" encoding="UTF-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Press the background. -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#1E88E5" /> <!-- Deep blue background when pressed -->
            <corners android:radius="3dp" /> <!-- Round angle radius -->
            <stroke android:width="1dp" android:color="#1565C0" /> <!-- Border Deep Blue -->
        </shape>
    </item>

    <!-- Default Background -->
    <item>
        <shape>
            <solid android:color="#2196F3" /> <!-- Default Light Blue Background -->
            <corners android:radius="3dp" /> <!-- Round angle radius -->
            <stroke android:width="1dp" android:color="#1E88E5" /> <!-- Border Blue -->
        </shape>
    </item>
</selector>
