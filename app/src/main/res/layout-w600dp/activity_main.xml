<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation rail (same five tabs as the bottom bar) is the only primary navigation; Help and About live under Settings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorSurface" android:orientation="horizontal">
    <com.google.android.material.navigationrail.NavigationRailView android:id="@+id/tabs"
        android:layout_width="120dp" android:layout_height="match_parent"
        android:contentDescription="@string/description_navigation_main" />
    <FrameLayout android:id="@id/fragment_container" android:layout_width="0dp"
        android:layout_height="match_parent" android:layout_weight="1" />
</LinearLayout>
