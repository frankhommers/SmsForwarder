<?xml version="1.0" encoding="utf-8"?>
<!--
  Logs filter dialog content. LogsFragment shows it with MaterialAlertDialogBuilder: a title and this view only
  (no message, no platform buttons). Previously the shared MaterialDialog wrapper always set a message; with a
  message panel and a custom panel both visible, AlertDialogLayout skips its own measure and the plain
  LinearLayout fallback squeezed the Reset/Search buttons to 12dp.
  Height: the custom panel gets the space left under the title. Here the form scrolls (weight 1, shrinks
  first) and the action row sits outside the scroll view at its full height; LogsFilterActionBar stacks
  the buttons on separate rows when they do not fit side by side, instead of hiding or squeezing any.
  Insets: ?attr/dialogPreferredPadding (24dp) start/end, the same edge as the title; 16dp between fields,
  24dp between sections (Form.* pattern). Labels are field hints or section titles, never bold side labels.
  Kept ids and types: layout_title, layout_sim_slot, layout_call_type (LinearLayout); et_from, et_title,
  et_content, et_start_time, et_end_time (TextInputEditText); rg_sim_slot (RadioGroup) with rb_sim_slot_0..2
  (MaterialRadioButton); scb_call_type1..6 and scb_forward_status_0..2 (TargetCheckBox).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/logs_filter_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/logs_filter_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:scrollIndicators="top|bottom"
        android:scrollbars="vertical"
        tools:targetApi="m">

        <LinearLayout
            android:id="@+id/logs_filter_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="?attr/dialogPreferredPadding"
            android:paddingTop="16dp"
            android:paddingEnd="?attr/dialogPreferredPadding"
            android:paddingBottom="8dp">

            <!-- Text filters: each matches when the stored value contains the text. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_logs_filter_from"
                style="@style/Form.Field"
                android:hint="@string/logs_filter_from_sms">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_from"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- App notification logs only. -->
            <LinearLayout
                android:id="@+id/layout_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Form.Field.Next"
                    android:hint="@string/logs_filter_app_title">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_logs_filter_message"
                style="@style/Form.Field.Next"
                android:hint="@string/logs_filter_message">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Time period: read-only fields; a tap opens the date and then the time picker, the end icon clears. -->
            <LinearLayout style="@style/Form.Section">

                <TextView
                    style="@style/Form.SectionTitle"
                    android:text="@string/logs_filter_period" />

                <TextView
                    style="@style/Form.Supporting"
                    android:text="@string/logs_filter_period_help" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_logs_filter_start"
                    style="@style/Form.Field.Next"
                    android:hint="@string/logs_filter_start"
                    app:endIconContentDescription="@string/logs_filter_clear_start"
                    app:endIconDrawable="@drawable/logs_filter_ic_clear"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_start_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:cursorVisible="false"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:importantForAutofill="no"
                        android:inputType="none"
                        android:longClickable="false"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_logs_filter_end"
                    style="@style/Form.Field.Next"
                    android:hint="@string/logs_filter_end"
                    app:endIconContentDescription="@string/logs_filter_clear_end"
                    app:endIconDrawable="@drawable/logs_filter_ic_clear"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_end_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:cursorVisible="false"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:importantForAutofill="no"
                        android:inputType="none"
                        android:longClickable="false"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- SMS and call logs only. -->
            <LinearLayout
                android:id="@+id/layout_sim_slot"
                style="@style/Form.Section">

                <TextView
                    style="@style/Form.SectionTitle"
                    android:text="@string/sim_slot" />

                <RadioGroup
                    android:id="@+id/rg_sim_slot"
                    style="@style/Form.OptionGroup">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_sim_slot_0"
                        style="@style/Form.Option"
                        android:checked="true"
                        android:text="@string/sim_any" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_sim_slot_1"
                        style="@style/Form.Option"
                        android:text="@string/sim_1" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_sim_slot_2"
                        style="@style/Form.Option"
                        android:text="@string/sim_2" />
                </RadioGroup>
            </LinearLayout>

            <!-- Call logs only. Same visual order as the previous dialog. -->
            <LinearLayout
                android:id="@+id/layout_call_type"
                style="@style/Form.Section">

                <TextView
                    style="@style/Form.SectionTitle"
                    android:text="@string/call_type" />

                <TextView
                    style="@style/Form.Supporting"
                    android:text="@string/logs_filter_none_means_all" />

                <cn.ppps.forwarder.widget.material.TargetCheckBox
                    android:id="@+id/scb_call_type3"
                    style="@style/Form.CheckRow"
                    android:layout_marginTop="8dp"
                    android:text="@string/missed_call" />

                <cn.ppps.forwarder.widget.material.TargetCheckBox
                    android:id="@+id/scb_call_type1"
                    style="@style/Form.CheckRow"
                    android:text="@string/incoming_call_ended" />

                <cn.ppps.forwarder.widget.material.TargetCheckBox
                    android:id="@+id/scb_call_type2"
                    style="@style/Form.CheckRow"
                    android:text="@string/outgoing_call_ended" />

                <cn.ppps.forwarder.widget.material.TargetCheckBox
                    android:id="@+id/scb_call_type4"
                    style="@style/Form.CheckRow"
                    android:text="@string/incoming_call_received" />

                <cn.ppps.forwarder.widget.material.TargetCheckBox
                    android:id="@+id/scb_call_type5"
                    style="@style/Form.CheckRow"
                    android:text="@string/incoming_call_answered" />

                <cn.ppps.forwarder.widget.material.TargetCheckBox
                    android:id="@+id/scb_call_type6"
                    style="@style/Form.CheckRow"
                    android:text="@string/outgoing_call_started" />
            </LinearLayout>

            <LinearLayout style="@style/Form.Section">

                <TextView
                    style="@style/Form.SectionTitle"
                    android:text="@string/logs_filter_result" />

                <TextView
                    style="@style/Form.Supporting"
                    android:text="@string/logs_filter_none_means_all" />

                <cn.ppps.forwarder.widget.material.TargetCheckBox
                    android:id="@+id/scb_forward_status_2"
                    style="@style/Form.CheckRow"
                    android:layout_marginTop="8dp"
                    android:text="@string/success" />

                <cn.ppps.forwarder.widget.material.TargetCheckBox
                    android:id="@+id/scb_forward_status_0"
                    style="@style/Form.CheckRow"
                    android:text="@string/failed" />

                <cn.ppps.forwarder.widget.material.TargetCheckBox
                    android:id="@+id/scb_forward_status_1"
                    style="@style/Form.CheckRow"
                    android:text="@string/processing" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!--
      Actions (order matters for LogsFilterActionBar): Reset at the start; Cancel and Apply at the end, Apply
      outermost. Bottom: 20dp + the buttons' own 4dp inset (48dp touch, 40dp visible) = 24dp to the dialog edge.
    -->
    <cn.ppps.forwarder.fragment.LogsFilterActionBar
        android:id="@+id/logs_filter_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/dialogPreferredPadding"
        android:paddingTop="8dp"
        android:paddingEnd="?attr/dialogPreferredPadding"
        android:paddingBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logs_filter_reset"
            style="@style/Widget.Material3.Button.TextButton.Dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logs_filter_cancel"
            style="@style/Widget.Material3.Button.TextButton.Dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logs_filter_apply"
            style="@style/Widget.Material3.Button.TextButton.Dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/m3_apply" />
    </cn.ppps.forwarder.fragment.LogsFilterActionBar>
</LinearLayout>
