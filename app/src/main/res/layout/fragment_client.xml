<?xml version="1.0" encoding="utf-8"?>
<!-- Client (Form pattern): one 16dp keyline, full-width server URL field, stacked security options. Ids and view types unchanged
     (tv_sign_key stays a TextView: ClientFragment sets it to Signing key / Public key / SM4 key per mode). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical" tools:ignore="Overdraw">
    <androidx.core.widget.NestedScrollView style="@style/ScrollViewStyle">
        <LinearLayout style="@style/Form.Content">

            <!-- Server address -->
            <LinearLayout style="@style/Form.Section.First">
                <TextView style="@style/Form.SectionTitle" android:text="@string/server_settings" />
                <TextView style="@style/Form.Supporting" android:text="@string/server_settings_tips2" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/service_address" app:helperText="@string/service_address_hint">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_server_address" android:inputType="textUri" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Security: must match the server -->
            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/safety_measures" />
                <TextView style="@style/Form.Supporting" android:text="@string/safety_measures_tips" />
                <RadioGroup android:id="@+id/rg_safety_measures" style="@style/Form.OptionGroup">
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_safety_measures_none" style="@style/Form.Option" android:checked="true" android:text="@string/safety_measures_none" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_safety_measures_sign" style="@style/Form.Option" android:text="@string/safety_measures_sign" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_safety_measures_rsa" style="@style/Form.Option" android:text="@string/safety_measures_rsa" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_safety_measures_sm4" style="@style/Form.Option" android:text="@string/safety_measures_sm4" />
                </RadioGroup>
                <LinearLayout android:id="@+id/layout_sign_key" style="@style/Form.Subsection">
                    <TextView android:id="@+id/tv_sign_key" style="@style/Form.GroupTitle" android:text="@string/sign_key" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:layout_marginTop="8dp">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_sign_key" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <LinearLayout style="@style/InfraForm.ButtonRow" android:layout_marginTop="16dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_server_test" style="@style/InfraForm.Button" android:layout_marginTop="0dp" android:text="@string/server_test" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_server_history" style="@style/InfraForm.Button.Outlined" android:layout_marginTop="0dp" android:layout_marginStart="8dp" android:text="@string/server_history" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_wechat_miniprogram" style="@style/InfraForm.Button.Outlined" android:layout_marginTop="0dp" android:layout_marginStart="8dp" android:text="@string/about_item_wechat_miniprogram" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Remote features offered by the server -->
            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/features_list" />
                <TextView style="@style/Form.Supporting" android:text="@string/click_test_button_first" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:nestedScrollingEnabled="false" android:overScrollMode="never" tools:listitem="@android:layout/simple_list_item_2" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
