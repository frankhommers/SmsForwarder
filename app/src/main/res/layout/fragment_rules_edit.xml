<?xml version="1.0" encoding="utf-8"?>
<!-- Form pattern pilot (see privacy-verification/form-pattern/PATTERN.md). Serves SMS, call and app rules;
     RulesEditFragment shows/hides rows per rule type and per selected 'Veld' option. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never">
        <LinearLayout style="@style/Form.Content">

            <!-- Name and targets -->
            <LinearLayout style="@style/Form.Section.First">
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/rule_title" app:helperText="@string/rule_title_tips">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_title" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <cn.ppps.forwarder.widget.material.TargetEditDropdown android:id="@+id/sp_sender" style="@style/Form.Dropdown.Next" android:theme="@style/ThemeOverlay.Material3.AutoCompleteTextView.OutlinedBox" app:es_hint="@string/select_sender" app:helperText="@string/choose_sender" app:es_maxLength="20" app:es_maxLine="1" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_senders" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                <LinearLayout android:id="@+id/layout_sender_logic" style="@style/Form.Subsection" android:visibility="gone">
                    <TextView style="@style/Form.GroupTitle" android:text="@string/sender_logic" />
                    <RadioGroup android:id="@+id/rg_sender_logic" style="@style/Form.OptionGroup">
                        <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_sender_logic_all" style="@style/Form.Option" android:checked="true" android:text="@string/sender_logic_all" />
                        <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_sender_logic_until_fail" style="@style/Form.Option" android:text="@string/sender_logic_until_fail" />
                        <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_sender_logic_until_success" style="@style/Form.Option" android:text="@string/sender_logic_until_success" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>

            <!-- SIM slot (hidden for app rules) -->
            <LinearLayout android:id="@+id/layout_sim_slot" style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/match_sim_slot" />
                <RadioGroup android:id="@+id/rg_sim_slot" style="@style/Form.OptionGroup">
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_sim_slot_all" style="@style/Form.Option" android:checked="true" android:text="@string/sim_any" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_sim_slot_1" style="@style/Form.Option" android:text="@string/sim_1" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_sim_slot_2" style="@style/Form.Option" android:text="@string/sim_2" />
                </RadioGroup>
            </LinearLayout>

            <!-- Condition: field, match type, value -->
            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/match_field" />
                <RadioGroup android:id="@+id/rg_filed" style="@style/Form.OptionGroup">
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_transpond_all" style="@style/Form.Option" android:checked="true" android:text="@string/all" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_phone" style="@style/Form.Option" android:text="@string/phone_number" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_call_type" style="@style/Form.Option" android:text="@string/call_type" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_content" style="@style/Form.Option" android:text="@string/sms_content" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_package_name" style="@style/Form.Option" android:text="@string/package_name" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_uid" style="@style/Form.Option" android:text="@string/uid" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_inform_content" style="@style/Form.Option" android:text="@string/inform_content" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_multi_match" style="@style/Form.Option" android:text="@string/multiple_matches" />
                </RadioGroup>
                <LinearLayout android:id="@+id/layout_match_type" style="@style/Form.Subsection" android:visibility="gone">
                    <TextView style="@style/Form.GroupTitle" android:text="@string/match_type" />
                    <!-- Two RadioGroups that RulesEditFragment keeps mutually exclusive; stacked so they read as one list. -->
                    <RadioGroup android:id="@+id/rg_check" style="@style/Form.OptionGroup">
                        <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_is" style="@style/Form.Option" android:checked="true" android:text="@string/btn_is" />
                        <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_contain" style="@style/Form.Option" android:text="@string/btn_contain" />
                        <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_not_contain" style="@style/Form.Option" android:text="@string/btn_not_contain" />
                    </RadioGroup>
                    <RadioGroup android:id="@+id/rg_check2" style="@style/Form.OptionGroup" android:layout_marginTop="0dp">
                        <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_start_with" style="@style/Form.Option" android:text="@string/btn_start_with" />
                        <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_end_with" style="@style/Form.Option" android:text="@string/btn_end_with" />
                        <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_regex" style="@style/Form.Option" android:text="@string/btn_regex" />
                    </RadioGroup>
                </LinearLayout>
                <LinearLayout android:id="@+id/layout_match_value" style="@style/Form.Subsection" android:visibility="gone">
                    <!-- FormFieldLayout hides its outline whenever Kotlin/ItemRows hide et_value (call type, multiple conditions). -->
                    <cn.ppps.forwarder.widget.material.FormFieldLayout style="@style/Form.Field" android:hint="@string/match_value" app:helperText="@string/match_value_tips">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" app:met_clearButton="true" />
                    </cn.ppps.forwarder.widget.material.FormFieldLayout>
                    <cn.ppps.forwarder.widget.material.TargetDropdown android:id="@+id/sp_call_type" style="@style/Form.Dropdown" android:theme="@style/ThemeOverlay.Material3.AutoCompleteTextView.OutlinedBox" android:hint="@string/call_type" android:visibility="gone" />
                    <LinearLayout android:id="@+id/layout_app_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:visibility="gone">
                        <cn.ppps.forwarder.widget.material.TargetEditDropdown android:id="@+id/sp_app" style="@style/Form.Dropdown" android:theme="@style/ThemeOverlay.Material3.AutoCompleteTextView.OutlinedBox" app:es_hint="@string/choose_app" app:helperText="@string/choose_app_hint" app:es_maxLength="20" app:es_maxLine="1" />
                    </LinearLayout>
                    <TextView android:id="@+id/tv_mu_rule_tips" style="@style/Form.Supporting" android:layout_marginTop="8dp" android:text="@string/mu_rule_sms_tips" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Message handling -->
            <LinearLayout style="@style/Form.Section">
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_sms_template" style="@style/Form.SwitchRow" android:text="@string/enable_custom_templates" />
                <LinearLayout android:id="@+id/layout_sms_template" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:visibility="gone">
                    <TextView style="@style/Form.Supporting" android:layout_marginTop="0dp" android:text="@string/enable_custom_templates_tips" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/custom_template">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_sms_template" android:inputType="textMultiLine" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <GridLayout android:id="@+id/gl_sms_template" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:columnCount="4" android:orientation="horizontal" />
                </LinearLayout>
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_regex_replace" style="@style/Form.SwitchRow" android:layout_marginTop="16dp" android:text="@string/enable_regex_replace" />
                <LinearLayout android:id="@+id/layout_regex_replace" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:visibility="gone">
                    <TextView style="@style/Form.Supporting" android:layout_marginTop="0dp" android:text="@string/enable_regex_replace_tips" />
                    <!-- Hidden backing field: ItemRows (followVisibility) mirrors it into per-item rows right after it. -->
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_regex_replace" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" app:met_clearButton="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Status and quiet hours -->
            <LinearLayout style="@style/Form.Section">
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_status" style="@style/Form.SwitchRow" android:checked="true" android:text="@string/switch_rule_status" />
                <LinearLayout android:id="@+id/layout_silent_period" style="@style/Form.Subsection" android:layout_marginTop="24dp" tools:ignore="RtlSymmetry">
                    <TextView style="@style/Form.SectionTitle" android:text="@string/silent_time_period" />
                    <TextView style="@style/Form.Supporting" android:text="@string/silent_time_period_tips" tools:ignore="TooManyViews" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:minHeight="48dp" android:orientation="horizontal">
                        <TextView android:id="@+id/tv_silent_period" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="none" android:gravity="center_vertical|start" android:maxLines="1" android:singleLine="true" android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
                        <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btn_silent_period" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:minHeight="48dp" android:text="@string/select" />
                    </LinearLayout>
                    <TextView style="@style/Form.GroupTitle" android:layout_marginTop="16dp" android:text="@string/form_quiet_days" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
                        <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/mon" style="@style/Form.CheckRow" android:text="@string/mon" />
                        <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/tue" style="@style/Form.CheckRow" android:text="@string/tue" />
                        <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/wed" style="@style/Form.CheckRow" android:text="@string/wed" />
                        <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/thu" style="@style/Form.CheckRow" android:text="@string/thu" />
                        <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/fri" style="@style/Form.CheckRow" android:text="@string/fri" />
                        <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/sat" style="@style/Form.CheckRow" android:text="@string/sat" />
                        <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/sun" style="@style/Form.CheckRow" android:text="@string/sun" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:padding="10dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_del" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_delete" android:text="@string/del" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/MaterialActionButton" android:drawableStart="@drawable/ic_save" android:text="@string/save" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_test" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_test" android:text="@string/test" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
    </LinearLayout>
</LinearLayout>
