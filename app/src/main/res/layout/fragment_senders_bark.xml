<?xml version="1.0" encoding="utf-8"?>
<!-- Form pattern (privacy-verification/form-pattern/PATTERN.md + TargetForm.* in styles_target_form.xml): one 16dp keyline from Form.Content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never" android:fillViewport="true">
        <LinearLayout style="@style/Form.Content">

            <!-- Name and status -->
            <LinearLayout style="@style/Form.Section.First">
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/m3_target_name">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_name" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_enable" style="@style/Form.SwitchRow" android:layout_marginTop="8dp" android:checked="true" android:text="@string/status_param_option_enabled" />
            </LinearLayout>

            <!-- Push address -->
            <LinearLayout style="@style/Form.Section">
                <LinearLayout style="@style/Form.HelpRow">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:layout_width="0dp" android:layout_weight="1" android:hint="@string/bark_server" app:helperText="@string/bark_server_tips">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_server" android:inputType="textUri" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btn_help_server" style="@style/Form.HelpIcon" android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Notification options -->
            <LinearLayout style="@style/Form.Section">
                <LinearLayout style="@style/TargetForm.TitleRow">
                    <TextView style="@style/Form.SectionTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/target_form_section_notification" />
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btn_help_notification" style="@style/Form.HelpIcon" />
                </LinearLayout>
                <cn.ppps.forwarder.widget.material.TargetDropdown android:id="@+id/sp_level" style="@style/Form.Dropdown" android:layout_marginTop="8dp" android:theme="@style/ThemeOverlay.Material3.AutoCompleteTextView.OutlinedBox" android:hint="@string/bark_level" />
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_call" style="@style/Form.SwitchRow" android:layout_marginTop="8dp" android:checked="true" android:text="@string/target_form_bark_call" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:layout_marginTop="8dp" android:hint="@string/bark_sound" app:helperText="@string/bark_sound_tips">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_sound" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/bark_group" app:helperText="@string/bark_group_tips">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_group" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/bark_badge" app:helperText="@string/bark_badge_tips">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_badge" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/bark_icon" app:helperText="@string/bark_icon_tips">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_icon" android:inputType="textUri" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/bark_url" app:helperText="@string/target_form_bark_url_helper">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_url" android:inputType="textUri" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Templates: notification title and the text Bark copies -->
            <LinearLayout style="@style/Form.Section">
                <LinearLayout style="@style/TargetForm.TitleRow">
                    <TextView style="@style/Form.SectionTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/target_form_section_templates" />
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btn_help_templates" style="@style/Form.HelpIcon" />
                </LinearLayout>
                <LinearLayout android:id="@+id/layout_custom_template" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/title_template" app:helperText="@string/target_form_template_default_sender">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_title_template" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_tags_title_template" style="@style/TargetForm.TagToggle" android:text="@string/target_form_tags_show" />
                    <GridLayout android:id="@+id/gl_title_template" style="@style/TargetForm.TagGrid" />
                </LinearLayout>
                <LinearLayout android:id="@+id/layout_auto_copy_template" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/auto_copy" app:helperText="@string/target_form_bark_auto_copy_helper">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_auto_copy_template" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_tags_auto_copy_template" style="@style/TargetForm.TagToggle" android:text="@string/target_form_tags_show" />
                    <GridLayout android:id="@+id/gl_auto_copy_template" style="@style/TargetForm.TagGrid" />
                </LinearLayout>
            </LinearLayout>

            <!-- Encryption -->
            <LinearLayout style="@style/Form.Section">
                <LinearLayout style="@style/TargetForm.TitleRow">
                    <TextView style="@style/Form.SectionTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/target_form_section_encryption" />
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btn_help_encryption" style="@style/Form.HelpIcon" />
                </LinearLayout>
                <cn.ppps.forwarder.widget.material.TargetDropdown android:id="@+id/sp_encryption_algorithm" style="@style/Form.Dropdown" android:layout_marginTop="8dp" android:theme="@style/ThemeOverlay.Material3.AutoCompleteTextView.OutlinedBox" android:hint="@string/bark_encryption_algorithm" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/bark_encryption_key" app:helperText="@string/bark_encryption_key_tips">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_encryption_key" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/bark_encryption_iv" app:helperText="@string/target_form_bark_iv_helper">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_encryption_iv" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:padding="10dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_del" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_delete" android:text="@string/del" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/MaterialActionButton" android:drawableStart="@drawable/ic_save" android:text="@string/save" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_test" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_test" android:text="@string/test" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
    </LinearLayout>
</LinearLayout>
