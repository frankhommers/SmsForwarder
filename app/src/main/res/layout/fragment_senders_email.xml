<?xml version="1.0" encoding="utf-8"?>
<!-- Form pattern (privacy-verification/form-pattern/PATTERN.md + TargetForm.* in styles_target_form.xml): one 16dp keyline from Form.Content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never" android:fillViewport="true">
        <LinearLayout style="@style/Form.Content">

            <!-- Name and status -->
            <LinearLayout style="@style/Form.Section.First">
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/m3_target_name">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_name" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_enable" style="@style/Form.SwitchRow" android:layout_marginTop="8dp" android:checked="true" android:text="@string/status_param_option_enabled" />
            </LinearLayout>

            <!-- Email account -->
            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/email_account" />
                <cn.ppps.forwarder.widget.material.TargetDropdown android:id="@+id/sp_mail_type" style="@style/Form.Dropdown" android:layout_marginTop="8dp" android:theme="@style/ThemeOverlay.Material3.AutoCompleteTextView.OutlinedBox" android:hint="@string/target_form_email_provider" app:helperText="@string/target_form_email_provider_helper" app:ms_entries="@array/MailType" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/target_form_email_address" app:helperText="@string/target_form_email_address_helper">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_from_email" android:inputType="textEmailAddress" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/email_password" app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_pwd" android:importantForAutofill="no" android:inputType="textPassword" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/email_from_alias" app:helperText="@string/email_from_alias_tips">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_from_email_alias" android:inputType="textEmailAddress" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:id="@+id/layout_sms_template_to_nickname" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/email_nickname" app:helperText="@string/target_form_template_default_sender">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_nickname" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_tags_nickname" style="@style/TargetForm.TagToggle" android:text="@string/target_form_tags_show" />
                    <GridLayout android:id="@+id/gl_nickname" style="@style/TargetForm.TagGrid" />
                </LinearLayout>
            </LinearLayout>

            <!-- Own SMTP server: EmailFragment shows this only for the "other" provider -->
            <LinearLayout android:id="@+id/layoutServiceSetting" style="@style/Form.Section" android:visibility="gone">
                <LinearLayout style="@style/TargetForm.TitleRow">
                    <TextView style="@style/Form.SectionTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/target_form_section_smtp" />
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btn_help_smtp" style="@style/Form.HelpIcon" />
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:layout_marginTop="8dp" android:hint="@string/email_host">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_host" android:inputType="textUri" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/smtp_port" app:helperText="@string/target_form_smtp_port_helper">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_port" android:digits="0123456789" android:inputType="number" android:maxLength="5" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_ssl" style="@style/Form.SwitchRow" android:layout_marginTop="8dp" android:checked="true" android:text="@string/enable_ssl" />
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_startTls" style="@style/Form.SwitchRow" android:checked="false" android:text="@string/enable_starttls" />
            </LinearLayout>

            <!-- Encryption -->
            <LinearLayout style="@style/Form.Section">
                <LinearLayout style="@style/TargetForm.TitleRow">
                    <TextView style="@style/Form.SectionTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/encryption_protocol" />
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btn_help_encryption" style="@style/Form.HelpIcon" />
                </LinearLayout>
                <RadioGroup android:id="@+id/rg_encryption_protocol" style="@style/Form.OptionGroup">
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_encryption_protocol_plain" style="@style/Form.Option" android:checked="true" android:text="@string/plain" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_encryption_protocol_smime" style="@style/Form.Option" android:text="@string/smime" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_encryption_protocol_openpgp" style="@style/Form.Option" android:text="@string/openpgp" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_encryption_protocol_openkeychain" style="@style/Form.Option" android:text="@string/openkeychain" />
                </RadioGroup>

                <!-- S/MIME, OpenPGP, OpenKeychain: unencrypted fallback (stored as allowUnencryptedFallback, default off).
                     Disabled with its value kept while Unencrypted is selected. -->
                <LinearLayout android:id="@+id/layout_unencrypted_fallback" style="@style/Form.Subsection">
                    <LinearLayout style="@style/Form.HelpRow.Heading">
                        <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_unencrypted_fallback" style="@style/Form.SwitchRow" android:layout_width="0dp" android:layout_weight="1" android:checked="false" android:text="@string/target_form_email_fallback" />
                        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btn_help_unencrypted_fallback" style="@style/Form.HelpIcon" />
                    </LinearLayout>
                    <TextView android:id="@+id/tv_unencrypted_fallback_state" style="@style/Form.Supporting" android:layout_marginTop="0dp" android:text="@string/target_form_email_fallback_off" />
                </LinearLayout>

                <!-- OpenKeychain only: optional signing key -->
                <LinearLayout android:id="@+id/layout_openkeychain_sign_key" style="@style/Form.Subsection" android:visibility="gone">
                    <LinearLayout style="@style/TargetForm.TitleRow">
                        <TextView style="@style/Form.GroupTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/target_form_openkeychain_sign_key" />
                        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btn_help_sign_key" style="@style/Form.HelpIcon" />
                    </LinearLayout>
                    <TextView android:id="@+id/tv_openkeychain_sign_key" style="@style/TargetForm.Value" android:layout_marginTop="0dp" android:text="@string/openkeychain_sign_key_none" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_openkeychain_sign_key_picker" style="@style/Form.Action" android:text="@string/openkeychain_select_sign_key" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_openkeychain_sign_key_clear" style="@style/Form.Disclosure" android:text="@string/openkeychain_clear_sign_key" />
                </LinearLayout>

                <!-- S/MIME and OpenPGP: optional own key for signing (tv_sender_keystore text is set by EmailFragment) -->
                <LinearLayout android:id="@+id/layout_sender_keystore" style="@style/Form.Subsection" android:visibility="gone">
                    <TextView android:id="@+id/tv_sender_keystore" style="@style/Form.GroupTitle" android:text="@string/sender_smime_keystore" />
                    <TextView style="@style/Form.Supporting" android:text="@string/target_form_sender_key_supporting" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:layout_marginTop="16dp" android:hint="@string/keystore_base64" app:helperText="@string/target_form_key_file_helper">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_sender_keystore" android:gravity="start|top" android:importantForAutofill="no" android:inputType="textMultiLine" android:maxLines="5" android:minLines="2" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_sender_keystore_picker" style="@style/Form.Action" android:text="@string/select_file" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/keystore_password" app:endIconMode="password_toggle" app:helperText="@string/target_form_sender_key_password_helper">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_sender_password" android:importantForAutofill="no" android:inputType="textPassword" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Recipients: EmailFragment appends one item_add_recipient row per address to this layout -->
            <LinearLayout android:id="@+id/layout_recipients" style="@style/Form.Section">
                <LinearLayout style="@style/TargetForm.TitleRow">
                    <TextView android:id="@+id/tv_email_to" style="@style/Form.SectionTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/email_to" />
                    <ImageView android:id="@+id/btn_add_recipient" style="@style/TargetForm.IconAction" android:contentDescription="@string/copy_add_recipient" android:src="@drawable/ic_add" app:tint="?attr/colorPrimary" />
                </LinearLayout>
                <TextView android:id="@+id/tv_email_to_tips" style="@style/Form.Supporting" android:layout_marginTop="0dp" android:text="@string/target_form_email_to_tips" />
            </LinearLayout>

            <!-- Subject -->
            <LinearLayout android:id="@+id/layout_sms_template" style="@style/Form.Section">
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/email_title" app:helperText="@string/target_form_template_default_sender">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_title_template" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_tags_title_template" style="@style/TargetForm.TagToggle" android:text="@string/target_form_tags_show" />
                <GridLayout android:id="@+id/gl_title_template" style="@style/TargetForm.TagGrid" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:padding="10dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_del" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_delete" android:text="@string/del" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/MaterialActionButton" android:drawableStart="@drawable/ic_save" android:text="@string/save" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_test" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_test" android:text="@string/test" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
    </LinearLayout>
</LinearLayout>
