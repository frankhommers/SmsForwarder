<?xml version="1.0" encoding="utf-8"?>
<!-- Form pattern (privacy-verification/form-pattern/PATTERN.md): one 16dp keyline from Form.Content. Ids, view classes, defaults and the ItemRows backing field are unchanged. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never">
        <LinearLayout style="@style/Form.Content">
            <LinearLayout style="@style/Form.Section.First">
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/m3_target_name">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_name" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_enable" style="@style/Form.SwitchRow" android:layout_marginTop="8dp" android:checked="true" android:text="@string/status_param_option_enabled" />
            </LinearLayout>
            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/SmsSimSlot" />
                <RadioGroup android:id="@+id/rg_simSlot" style="@style/Form.OptionGroup">
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_sim_slot_org" style="@style/Form.Option" android:checked="true" android:text="@string/same_source" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_sim_slot_1" style="@style/Form.Option" android:text="@string/sim1" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_sim_slot_2" style="@style/Form.Option" android:text="@string/sim2" />
                </RadioGroup>
            </LinearLayout>
            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/SmsMobiles" />
                <TextView style="@style/Form.Supporting" android:text="@string/SmsMobilesTips" />
                <!-- Hidden backing field: ItemRows (followVisibility) inserts Add recipient and one row per number right after it. -->
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_mobiles" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" android:singleLine="true" app:met_clearButton="true" />
                <com.google.android.material.button.MaterialButton android:id="@+id/bt_insert_sender" style="@style/Form.Action" android:text="@string/copy_reply_sender" />
                <com.google.android.material.button.MaterialButton android:id="@+id/bt_pick_contact" style="@style/Form.Action" android:text="@string/copy_pick_contact" />
            </LinearLayout>
            <LinearLayout style="@style/Form.Section">
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_onlyNoNetwork" style="@style/Form.SwitchRow" android:checked="true" android:text="@string/OnlyNoNetwork" />
                <TextView style="@style/Form.Supporting" android:text="@string/editor_form_sms_only_no_network_help" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:padding="10dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_del" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_delete" android:text="@string/del" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/MaterialActionButton" android:drawableStart="@drawable/ic_save" android:text="@string/save" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_test" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_test" android:text="@string/test" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
    </LinearLayout>
</LinearLayout>
