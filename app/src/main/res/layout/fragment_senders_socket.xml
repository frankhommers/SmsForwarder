<?xml version="1.0" encoding="utf-8"?>
<!-- Form pattern (privacy-verification/form-pattern/PATTERN.md): one 16dp keyline from Form.Content, labels inside outlined fields, stacked 48dp option and switch rows. Ids, view classes, defaults and the Kotlin-toggled layout_mqtt are unchanged. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:ns2="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical">
  <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never">
    <LinearLayout style="@style/Form.Content">
      <LinearLayout style="@style/Form.Section.First">
        <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/m3_target_name">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_name" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
        <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_enable" style="@style/Form.SwitchRow" android:layout_marginTop="8dp" android:checked="true" android:text="@string/status_param_option_enabled" />
      </LinearLayout>
      <LinearLayout style="@style/Form.Section">
        <TextView style="@style/Form.SectionTitle" android:text="@string/Method" />
        <RadioGroup android:id="@+id/rg_method" style="@style/Form.OptionGroup">
          <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_method_mqtt" style="@style/Form.Option" android:checked="true" android:text="@string/mqtt" />
          <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_method_tcp" style="@style/Form.Option" android:text="@string/tcp" />
          <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_method_udp" style="@style/Form.Option" android:text="@string/udp" />
        </RadioGroup>
      </LinearLayout>
      <LinearLayout style="@style/Form.Section">
        <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/editor_form_server_address" app:helperText="@string/editor_form_server_address_helper">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_address" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/port">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_port" android:digits="0123456789" android:inputType="number" android:maxLength="5" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
        <cn.ppps.forwarder.widget.material.TargetDropdown android:id="@+id/et_inCharset" style="@style/Form.Dropdown.Next" android:theme="@style/ThemeOverlay.Material3.AutoCompleteTextView.OutlinedBox" android:hint="@string/in_charset" android:layout_width="match_parent" android:singleLine="true" app:ms_entries="@array/charsets" />
        <cn.ppps.forwarder.widget.material.TargetDropdown android:id="@+id/et_outCharset" style="@style/Form.Dropdown.Next" android:theme="@style/ThemeOverlay.Material3.AutoCompleteTextView.OutlinedBox" android:hint="@string/out_charset" android:layout_width="match_parent" android:singleLine="true" app:ms_entries="@array/charsets" />
      </LinearLayout>
      <LinearLayout style="@style/Form.Section">
        <TextView style="@style/Form.SectionTitle" android:text="@string/target_form_section_message" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/editor_form_socket_payload" app:helperText="@string/editor_form_socket_template_helper">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_msgTemplate" android:singleLine="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/form_secret_label" app:helperText="@string/editor_form_socket_secret_helper">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_Secret" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/form_response_label" app:helperText="@string/webhook_response_help">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_Response" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
      </LinearLayout>
      <!-- MQTT only: SocketFragment shows this block for MQTT and hides it for TCP/UDP (values are kept). -->
      <LinearLayout android:id="@+id/layout_mqtt" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout style="@style/Form.Section">
          <TextView style="@style/Form.SectionTitle" android:text="@string/mqtt" />
          <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/username" app:helperText="@string/optional">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_username" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
          </com.google.android.material.textfield.TextInputLayout>
          <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/password" app:helperText="@string/optional" app:endIconMode="password_toggle">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_password" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" />
          </com.google.android.material.textfield.TextInputLayout>
          <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/in_message_topic" app:helperText="@string/in_message_topic_hint">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_inMessageTopic" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
          </com.google.android.material.textfield.TextInputLayout>
          <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/out_message_topic" app:helperText="@string/out_message_topic_hint">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_outMessageTopic" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
          </com.google.android.material.textfield.TextInputLayout>
          <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/client_id" app:helperText="@string/client_id_hint">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_clientId" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
          </com.google.android.material.textfield.TextInputLayout>
          <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/path" app:helperText="@string/path_hint">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_path" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
          </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <LinearLayout style="@style/Form.Section">
          <TextView style="@style/Form.SectionTitle" android:text="@string/uri_type" />
          <RadioGroup android:id="@+id/rg_uriType" style="@style/Form.OptionGroup">
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_uriType_tcp" style="@style/Form.Option" android:checked="true" android:text="@string/tcp" />
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_uriType_ssl" style="@style/Form.Option" android:text="@string/ssl" />
          </RadioGroup>
        </LinearLayout>
        <LinearLayout style="@style/Form.Section">
          <TextView style="@style/Form.SectionTitle" android:text="@string/qos" />
          <RadioGroup android:id="@+id/rg_qos" style="@style/Form.OptionGroup">
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_qos_0" style="@style/Form.Option" android:checked="true" android:text="@string/qos_0" />
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_qos_1" style="@style/Form.Option" android:text="@string/qos_1" />
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_qos_2" style="@style/Form.Option" android:text="@string/qos_2" />
          </RadioGroup>
          <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_retained" style="@style/Form.SwitchRow" android:layout_marginTop="16dp" android:text="@string/retained" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:padding="10dp">
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_del" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_delete" android:text="@string/del" ns2:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/MaterialActionButton" android:drawableStart="@drawable/ic_save" android:text="@string/save" ns2:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_test" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_test" android:text="@string/test" ns2:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
  </LinearLayout>
</LinearLayout>
