<?xml version="1.0" encoding="utf-8"?>
<!-- Server (Form pattern, styles_form.xml + styles_infra_form.xml): one 16dp keyline, labels inside fields, stacked rows. Ids and view types unchanged. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical">
    <androidx.core.widget.NestedScrollView style="@style/ScrollViewStyle">
        <LinearLayout style="@style/Form.Content">

            <!-- HTTP server: port, listen scope, autostart, status and start/stop -->
            <LinearLayout style="@style/Form.Section.First">
                <TextView style="@style/Form.SectionTitle" android:text="@string/http_server" />
                <TextView style="@style/Form.Supporting" android:text="@string/server_settings_tips" />
                <TextView style="@style/Form.Supporting" android:text="@string/server_safety_measures_tips" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/port">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_server_port" android:digits="0123456789" android:inputType="number" android:maxLength="5" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/sb_server_local_ip_only" style="@style/Form.CheckRow" android:layout_marginTop="8dp" android:text="@string/local_ip_only" />
                <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/scb_server_autorun" style="@style/Form.CheckRow" android:text="@string/auto_startup" />
                <TextView android:id="@+id/tv_server_tips" style="@style/Form.Supporting" android:layout_marginTop="8dp" android:text="@string/http_server_stopped" android:accessibilityLiveRegion="polite" />
                <LinearLayout style="@style/InfraForm.ButtonRow">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_toggle_server" style="@style/InfraForm.Button" android:layout_marginTop="0dp" android:text="@string/start_server" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/iv_copy" style="@style/InfraForm.Button.Outlined" android:layout_marginTop="0dp" android:layout_marginStart="8dp" android:text="@string/copy" android:visibility="gone" tools:ignore="PrivateResource" />
                </LinearLayout>
            </LinearLayout>

            <!-- Security mode and its key fields -->
            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/safety_measures" />
                <TextView style="@style/Form.Supporting" android:text="@string/safety_measures_tips" />
                <RadioGroup android:id="@+id/rg_safety_measures" style="@style/Form.OptionGroup">
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_safety_measures_none" style="@style/Form.Option" android:checked="true" android:text="@string/safety_measures_none" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_safety_measures_sign" style="@style/Form.Option" android:text="@string/safety_measures_sign" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_safety_measures_rsa" style="@style/Form.Option" android:text="@string/safety_measures_rsa" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_safety_measures_sm4" style="@style/Form.Option" android:text="@string/safety_measures_sm4" />
                </RadioGroup>
                <LinearLayout android:id="@+id/layout_sign_key" style="@style/Form.Subsection" android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/sign_key">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_sign_key" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_sign_key" style="@style/InfraForm.Button.Outlined" android:text="@string/random" />
                </LinearLayout>
                <LinearLayout android:id="@+id/layout_time_tolerance" style="@style/Form.Subsection" android:visibility="gone">
                    <TextView style="@style/Form.GroupTitle" android:text="@string/time_tolerance" />
                    <TextView style="@style/Form.Supporting" android:text="@string/time_tolerance_tips" />
                    <TextView android:id="@+id/tv_time_tolerance_value" style="@style/InfraForm.Readout" tools:text="600 seconds" />
                    <cn.ppps.forwarder.widget.material.TargetSlider android:id="@+id/xsb_time_tolerance" android:layout_width="match_parent" android:layout_height="wrap_content" app:xsb_max="600" app:xsb_min="1" />
                </LinearLayout>
                <LinearLayout android:id="@+id/layout_private_key" style="@style/Form.Subsection" android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/private_key" app:helperText="@string/private_key_tips">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_private_key" android:gravity="top" android:importantForAutofill="no" android:inputType="textMultiLine" android:maxLines="5" android:minLines="2" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_generate_key" style="@style/InfraForm.Button.Outlined" android:text="@string/generate_key" />
                </LinearLayout>
                <LinearLayout android:id="@+id/layout_public_key" style="@style/Form.Subsection" android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/public_key" app:helperText="@string/public_key_tips">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_public_key" android:gravity="top" android:importantForAutofill="no" android:inputType="textMultiLine" android:maxLines="5" android:minLines="2" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_copy_public_key" style="@style/InfraForm.Button.Outlined" android:text="@string/copy_public_key" />
                </LinearLayout>
                <LinearLayout android:id="@+id/layout_sm4_key" style="@style/Form.Subsection" android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/sm4_key" app:helperText="@string/sm4_key_tips">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_sm4_key" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_sm4_key" style="@style/InfraForm.Button.Outlined" android:text="@string/generate_key" />
                </LinearLayout>
            </LinearLayout>

            <!-- Web client folder -->
            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/web_client" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:layout_marginTop="8dp" android:hint="@string/review_web_folder" app:helperText="@string/web_path_tips">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_web_path" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_path_picker" style="@style/InfraForm.Button.Outlined" android:text="@string/select_directory" />
            </LinearLayout>

            <!-- Remotely controllable features -->
            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/enable_function" />
                <TextView style="@style/Form.Supporting" android:layout_marginBottom="8dp" android:text="@string/enable_function_tips" />
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_api_clone" style="@style/Form.SwitchRow" android:text="@string/api_clone" />
                <TextView android:id="@+id/tv_clone_encryption_requirement" style="@style/Form.Supporting" android:layout_marginTop="0dp" android:text="@string/infra_form_clone_requires_encryption" />
                <TextView style="@style/Form.Supporting" android:text="@string/api_clone_tips" />
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_api_query_sms" style="@style/Form.SwitchRow" android:layout_marginTop="8dp" android:text="@string/api_sms_query" />
                <TextView style="@style/Form.Supporting" android:layout_marginTop="0dp" android:text="@string/api_sms_query_tips" />
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_api_send_sms" style="@style/Form.SwitchRow" android:layout_marginTop="8dp" android:text="@string/api_sms_send" />
                <TextView style="@style/Form.Supporting" android:layout_marginTop="0dp" android:text="@string/api_sms_send_tips" />
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_api_query_call" style="@style/Form.SwitchRow" android:layout_marginTop="8dp" android:text="@string/api_call_query" />
                <TextView style="@style/Form.Supporting" android:layout_marginTop="0dp" android:text="@string/api_call_query_tips" />
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_api_query_contacts" style="@style/Form.SwitchRow" android:layout_marginTop="8dp" android:text="@string/api_contact_query" />
                <TextView style="@style/Form.Supporting" android:layout_marginTop="0dp" android:text="@string/api_contact_query_tips" />
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_api_add_contacts" style="@style/Form.SwitchRow" android:layout_marginTop="8dp" android:text="@string/api_contact_add" />
                <TextView style="@style/Form.Supporting" android:layout_marginTop="0dp" android:text="@string/api_contact_add_tips" />
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_api_wol" style="@style/Form.SwitchRow" android:layout_marginTop="8dp" android:text="@string/api_wol" />
                <TextView style="@style/Form.Supporting" android:layout_marginTop="0dp" android:text="@string/api_wol_tips" />
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_api_location" style="@style/Form.SwitchRow" android:layout_marginTop="8dp" android:text="@string/api_location" />
                <TextView style="@style/Form.Supporting" android:layout_marginTop="0dp" android:text="@string/api_location_tips" />
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_api_config_query" style="@style/Form.SwitchRow" android:layout_marginTop="8dp" android:text="@string/api_config_query" />
                <TextView style="@style/Form.Supporting" android:layout_marginTop="0dp" android:text="@string/api_config_query_tips" />
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_api_query_battery" style="@style/Form.SwitchRow" android:layout_marginTop="8dp" android:text="@string/api_battery_query" />
                <TextView style="@style/Form.Supporting" android:layout_marginTop="0dp" android:text="@string/api_battery_query_tips" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
