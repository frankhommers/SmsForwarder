<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never">
        <!-- Task-action form (ActionForm.* on top of the Form.* recipe, privacy-verification/form-pattern/PATTERN.md). Ids, view classes, defaults and show/hide logic unchanged. -->
        <LinearLayout style="@style/Form.Content">
            <androidx.appcompat.widget.AppCompatImageView style="@style/ActionForm.Hero" android:contentDescription="@string/task_alarm" app:srcCompat="@drawable/auto_task_icon_alarm" tools:ignore="ImageContrastCheck" />
            <LinearLayout style="@style/Form.Section.First">
                <TextView style="@style/Form.SectionTitle" android:text="@string/task_alarm" />
                <TextView android:id="@+id/tv_description" style="@style/Form.Supporting" android:text="@string/task_alarm_tips" />
                <RadioGroup android:id="@+id/rg_alarm_state" style="@style/Form.OptionGroup" android:layout_marginTop="16dp">
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_start_alarm" style="@style/Form.Option" android:checked="true" android:text="@string/start_alarm" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_stop_alarm" style="@style/Form.Option" android:text="@string/stop_alarm" />
                </RadioGroup>
            </LinearLayout>
            <LinearLayout android:id="@+id/layout_alarm_settings" style="@style/Form.Section">
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_enable_music" style="@style/Form.SwitchRow" android:text="@string/alarm_play_settings" />
                <LinearLayout android:id="@+id/layout_alarm_settings_content" style="@style/ActionForm.Nested">
                    <TextView android:id="@+id/action_form_volume_value" style="@style/ActionForm.SliderValue" android:layout_marginTop="8dp" />
                    <cn.ppps.forwarder.widget.material.TargetSlider android:id="@+id/xsb_volume" style="@style/ActionForm.Slider" android:contentDescription="@string/alarm_volume" app:xsb_max="100" app:xsb_min="1" />
                    <TextView android:id="@+id/action_form_play_times_value" style="@style/ActionForm.SliderValue" />
                    <cn.ppps.forwarder.widget.material.TargetSlider android:id="@+id/xsb_play_times" style="@style/ActionForm.Slider" android:contentDescription="@string/alarm_play_times" app:xsb_max="30" app:xsb_min="0" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/action_form_music_file" app:helperText="@string/action_form_music_help">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_music_path" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_file_picker" style="@style/Form.Action" android:text="@string/action_form_pick_music" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/layout_vibrate_settings" style="@style/Form.Section">
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_enable_vibrate" style="@style/Form.SwitchRow" android:text="@string/alarm_vibrate_settings" />
                <LinearLayout android:id="@+id/layout_vibrate_settings_content" style="@style/ActionForm.Nested">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/action_form_vibration_pattern" app:helperText="@string/action_form_vibration_help">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_vibration_effect" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout style="@style/ActionForm.ButtonRow">
                        <com.google.android.material.button.MaterialButton android:id="@+id/bt_insert_vibration_effect_1" style="@style/ActionForm.InsertButton" android:contentDescription="@string/action_form_insert_strong_desc" android:text="@string/action_form_insert_strong" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/bt_insert_vibration_effect_2" style="@style/ActionForm.InsertButton.Next" android:contentDescription="@string/action_form_insert_weak_desc" android:text="@string/action_form_insert_weak" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/bt_insert_vibration_effect_3" style="@style/ActionForm.InsertButton.Next" android:contentDescription="@string/action_form_insert_pause_desc" android:text="@string/action_form_insert_pause" />
                    </LinearLayout>
                    <TextView android:id="@+id/action_form_repeat_times_value" style="@style/ActionForm.SliderValue" />
                    <cn.ppps.forwarder.widget.material.TargetSlider android:id="@+id/xsb_repeat_times" style="@style/ActionForm.Slider" android:contentDescription="@string/alarm_repeat_times" app:xsb_max="30" app:xsb_min="0" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/layout_flash_settings" style="@style/Form.Section">
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_enable_flash" style="@style/Form.SwitchRow" android:text="@string/alarm_flash_settings" />
                <LinearLayout android:id="@+id/layout_flash_settings_content" style="@style/ActionForm.Nested">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/action_form_flash_pattern" app:helperText="@string/action_form_flash_help">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_flash_effect" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout style="@style/ActionForm.ButtonRow">
                        <com.google.android.material.button.MaterialButton android:id="@+id/bt_insert_flash_effect_1" style="@style/ActionForm.InsertButton" android:contentDescription="@string/action_form_insert_light_on_desc" android:text="@string/action_form_insert_light_on" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/bt_insert_flash_effect_2" style="@style/ActionForm.InsertButton.Next" android:contentDescription="@string/action_form_insert_light_off_desc" android:text="@string/action_form_insert_light_off" />
                    </LinearLayout>
                    <TextView android:id="@+id/action_form_flash_times_value" style="@style/ActionForm.SliderValue" />
                    <cn.ppps.forwarder.widget.material.TargetSlider android:id="@+id/xsb_flash_times" style="@style/ActionForm.Slider" android:contentDescription="@string/alarm_repeat_times" app:xsb_max="30" app:xsb_min="0" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:padding="10dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_del" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_delete" android:text="@string/discard" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/MaterialActionButton" android:drawableStart="@drawable/ic_save" android:text="@string/m3_apply" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_test" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_test" android:text="@string/test" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
    </LinearLayout>
</LinearLayout>
