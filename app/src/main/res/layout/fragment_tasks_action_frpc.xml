<?xml version="1.0" encoding="utf-8"?>
<!--
  Task-action form (ActionForm.* on top of the Form.* recipe, privacy-verification/form-pattern/PATTERN.md).
  This fork has no tunnel client (App.FrpclibInited is false): FrpcFragment shows the notice below and the saved
  choice read-only, with Apply and Test disabled; Discard leaves a saved action untouched. Ids and stored data unchanged.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never">
        <LinearLayout style="@style/Form.Content">
            <androidx.appcompat.widget.AppCompatImageView style="@style/ActionForm.Hero" android:contentDescription="@string/task_frpc" app:srcCompat="@drawable/auto_task_icon_frpc" tools:ignore="ImageContrastCheck" />
            <LinearLayout style="@style/Form.Section.First">
                <TextView style="@style/Form.SectionTitle" android:text="@string/task_frpc" />
                <TextView android:id="@+id/tv_description" style="@style/Form.Supporting" android:text="@string/editor_form_frpc_purpose" />
                <TextView android:id="@+id/editor_form_frpc_unavailable" style="@style/EditorForm.Notice" android:text="@string/editor_form_frpc_unavailable" />
            </LinearLayout>
            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.GroupTitle" android:text="@string/editor_form_frpc_action" />
                <RadioGroup android:id="@+id/rg_frpc_state" style="@style/Form.OptionGroup">
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_start_server" style="@style/Form.Option" android:checked="true" android:text="@string/start_server" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_stop_server" style="@style/Form.Option" android:text="@string/stop_server" />
                </RadioGroup>
            </LinearLayout>
            <LinearLayout style="@style/Form.Section">
                <cn.ppps.forwarder.widget.material.TargetEditDropdown android:id="@+id/sp_frpc" style="@style/Form.Dropdown" android:theme="@style/ThemeOverlay.Material3.AutoCompleteTextView.OutlinedBox" app:es_hint="@string/editor_form_frpc_configs" app:helperText="@string/editor_form_frpc_configs_helper" app:es_maxLength="20" app:es_maxLine="1" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_frpcs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_del"
            style="@style/MaterialActionButton.Secondary"
            android:drawableStart="@drawable/ic_delete"
            android:text="@string/discard"
            tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/MaterialActionButton"
            android:drawableStart="@drawable/ic_save"
            android:text="@string/m3_apply"
            tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_test"
            style="@style/MaterialActionButton.Secondary"
            android:drawableStart="@drawable/ic_test"
            android:text="@string/test"
            tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />

    </LinearLayout>

</LinearLayout>