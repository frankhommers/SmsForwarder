<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never">
        <!-- Task-action form (ActionForm.* on top of the Form.* recipe, privacy-verification/form-pattern/PATTERN.md). Ids, view classes, defaults and show/hide logic unchanged. -->
        <LinearLayout style="@style/Form.Content">
            <androidx.appcompat.widget.AppCompatImageView style="@style/ActionForm.Hero" android:contentDescription="@string/task_http_server" app:srcCompat="@drawable/auto_task_icon_http_server" tools:ignore="ImageContrastCheck" />
            <LinearLayout style="@style/Form.Section.First">
                <TextView style="@style/Form.SectionTitle" android:text="@string/task_http_server" />
                <TextView android:id="@+id/tv_description" style="@style/Form.Supporting" android:text="@string/task_http_server_tips" />
                <RadioGroup android:id="@+id/rg_http_server_state" style="@style/Form.OptionGroup" android:layout_marginTop="16dp">
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_start_server" style="@style/Form.Option" android:checked="true" android:text="@string/start_server" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_stop_server" style="@style/Form.Option" android:text="@string/stop_server" />
                </RadioGroup>
            </LinearLayout>
            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/action_form_remote_features" />
                <TextView style="@style/Form.Supporting" android:text="@string/enable_function_tips" />
                <LinearLayout style="@style/Form.Subsection">
                    <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_api_clone" style="@style/Form.SwitchRow" android:text="@string/api_clone" />
                    <TextView style="@style/Form.Supporting" android:text="@string/api_clone_tips" />
                </LinearLayout>
                <LinearLayout style="@style/Form.Subsection">
                    <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_api_query_sms" style="@style/Form.SwitchRow" android:text="@string/api_sms_query" />
                    <TextView style="@style/Form.Supporting" android:text="@string/api_sms_query_tips" />
                </LinearLayout>
                <LinearLayout style="@style/Form.Subsection">
                    <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_api_send_sms" style="@style/Form.SwitchRow" android:text="@string/api_sms_send" />
                    <TextView style="@style/Form.Supporting" android:text="@string/api_sms_send_tips" />
                </LinearLayout>
                <LinearLayout style="@style/Form.Subsection">
                    <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_api_query_call" style="@style/Form.SwitchRow" android:text="@string/api_call_query" />
                    <TextView style="@style/Form.Supporting" android:text="@string/api_call_query_tips" />
                </LinearLayout>
                <LinearLayout style="@style/Form.Subsection">
                    <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_api_query_contacts" style="@style/Form.SwitchRow" android:text="@string/api_contact_query" />
                    <TextView style="@style/Form.Supporting" android:text="@string/api_contact_query_tips" />
                </LinearLayout>
                <LinearLayout style="@style/Form.Subsection">
                    <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_api_add_contacts" style="@style/Form.SwitchRow" android:text="@string/api_contact_add" />
                    <TextView style="@style/Form.Supporting" android:text="@string/api_contact_add_tips" />
                </LinearLayout>
                <LinearLayout style="@style/Form.Subsection">
                    <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_api_wol" style="@style/Form.SwitchRow" android:text="@string/api_wol" />
                    <TextView style="@style/Form.Supporting" android:text="@string/api_wol_tips" />
                </LinearLayout>
                <LinearLayout style="@style/Form.Subsection">
                    <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_api_location" style="@style/Form.SwitchRow" android:text="@string/api_location" />
                    <TextView style="@style/Form.Supporting" android:text="@string/api_location_tips" />
                </LinearLayout>
                <LinearLayout style="@style/Form.Subsection">
                    <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_api_query_battery" style="@style/Form.SwitchRow" android:text="@string/api_battery_query" />
                    <TextView style="@style/Form.Supporting" android:text="@string/api_battery_query_tips" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:padding="10dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_del" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_delete" android:text="@string/discard" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/MaterialActionButton" android:drawableStart="@drawable/ic_save" android:text="@string/m3_apply" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_test" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_test" android:text="@string/test" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
    </LinearLayout>
</LinearLayout>
