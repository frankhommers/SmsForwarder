<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never">
        <!-- Task-action form (ActionForm.* on top of the Form.* recipe, privacy-verification/form-pattern/PATTERN.md). Ids, view classes, defaults and show/hide logic unchanged. -->
        <LinearLayout style="@style/Form.Content">
            <androidx.appcompat.widget.AppCompatImageView style="@style/ActionForm.Hero" android:contentDescription="@string/task_resend" app:srcCompat="@drawable/auto_task_icon_resend" tools:ignore="ImageContrastCheck" />
            <LinearLayout style="@style/Form.Section.First">
                <TextView style="@style/Form.SectionTitle" android:text="@string/task_resend" />
                <TextView android:id="@+id/tv_description" style="@style/Form.Supporting" android:text="@string/task_resend_tips" />
                <TextView android:id="@+id/action_form_hours_value" style="@style/ActionForm.SliderValue" />
                <cn.ppps.forwarder.widget.material.TargetSlider android:id="@+id/xsb_hours" style="@style/ActionForm.Slider" android:contentDescription="@string/action_form_hours" app:xsb_max="50" app:xsb_min="0" />
                <TextView style="@style/ActionForm.GroupTitle" android:text="@string/action_form_original_result" />
                <LinearLayout style="@style/ActionForm.CheckGroup">
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/scb_failed" style="@style/Form.CheckRow" android:text="@string/failed" app:scb_color_checked="@color/colorPrimary" />
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/scb_processing" style="@style/Form.CheckRow" android:text="@string/processing" app:scb_color_checked="@color/colorPrimary" />
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/scb_success" style="@style/Form.CheckRow" android:text="@string/success" app:scb_color_checked="@color/colorPrimary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:padding="10dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_del" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_delete" android:text="@string/discard" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/MaterialActionButton" android:drawableStart="@drawable/ic_save" android:text="@string/m3_apply" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_test" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_test" android:text="@string/test" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
    </LinearLayout>
</LinearLayout>
