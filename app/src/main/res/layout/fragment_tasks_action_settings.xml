<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never">
        <!-- Task-action form (ActionForm.* on top of the Form.* recipe, privacy-verification/form-pattern/PATTERN.md). Ids, view classes, defaults and show/hide logic unchanged. -->
        <LinearLayout style="@style/Form.Content">
            <androidx.appcompat.widget.AppCompatImageView style="@style/ActionForm.Hero" android:contentDescription="@string/task_settings" app:srcCompat="@drawable/auto_task_icon_settings" tools:ignore="ImageContrastCheck" />
            <LinearLayout style="@style/Form.Section.First">
                <TextView style="@style/Form.SectionTitle" android:text="@string/forwarding_function" />
                <TextView style="@style/Form.Supporting" android:text="@string/forwarding_function_tips" />
                <LinearLayout style="@style/Form.Subsection">
                    <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_enable_sms" style="@style/Form.SwitchRow" android:text="@string/forward_sms" />
                    <TextView style="@style/Form.Supporting" android:text="@string/forward_sms_tips" />
                </LinearLayout>
                <LinearLayout style="@style/Form.Subsection">
                    <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_enable_phone" style="@style/Form.SwitchRow" android:text="@string/forward_calls" />
                    <TextView style="@style/Form.Supporting" android:text="@string/forward_calls_tips" />
                    <TextView style="@style/ActionForm.GroupTitle" android:text="@string/action_form_call_types" />
                    <LinearLayout style="@style/ActionForm.CheckGroup">
                        <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/scb_call_type3" style="@style/Form.CheckRow" android:text="@string/missed_call" app:scb_color_checked="@color/colorPrimary" />
                        <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/scb_call_type1" style="@style/Form.CheckRow" android:text="@string/incoming_call_ended" app:scb_color_checked="@color/colorPrimary" />
                        <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/scb_call_type2" style="@style/Form.CheckRow" android:text="@string/outgoing_call_ended" app:scb_color_checked="@color/colorPrimary" />
                        <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/scb_call_type4" style="@style/Form.CheckRow" android:text="@string/incoming_call_received" app:scb_color_checked="@color/colorPrimary" />
                        <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/scb_call_type5" style="@style/Form.CheckRow" android:text="@string/incoming_call_answered" app:scb_color_checked="@color/colorPrimary" />
                        <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/scb_call_type6" style="@style/Form.CheckRow" android:text="@string/outgoing_call_started" app:scb_color_checked="@color/colorPrimary" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/Form.Subsection">
                    <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_enable_app_notify" style="@style/Form.SwitchRow" android:text="@string/forward_app_notify" />
                    <TextView style="@style/Form.Supporting" android:text="@string/forward_app_notify_tips" />
                    <LinearLayout android:id="@+id/layout_optional_action" style="@style/ActionForm.CheckGroup">
                        <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/scb_cancel_app_notify" style="@style/Form.CheckRow" android:text="@string/cancel_app_notify" app:scb_color_checked="@color/colorPrimary" />
                        <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/scb_not_user_present" style="@style/Form.CheckRow" android:text="@string/not_user_present" app:scb_color_checked="@color/colorPrimary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/extra_function" />
                <TextView style="@style/Form.Supporting" android:text="@string/extra_function_tips" />
                <LinearLayout style="@style/Form.Subsection">
                    <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_enable_location" style="@style/Form.SwitchRow" android:text="@string/enable_location" />
                    <TextView style="@style/Form.Supporting" android:text="@string/enable_location_tips" />
                    <LinearLayout android:id="@+id/layout_location_setting" style="@style/ActionForm.Nested">
                        <TextView style="@style/ActionForm.GroupTitle" android:text="@string/accuracy" />
                        <RadioGroup android:id="@+id/rg_accuracy" style="@style/Form.OptionGroup">
                            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_accuracy_fine" style="@style/Form.Option" android:checked="true" android:text="@string/accuracy_fine" />
                            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_accuracy_coarse" style="@style/Form.Option" android:text="@string/accuracy_coarse" />
                            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_accuracy_no_requirement" style="@style/Form.Option" android:text="@string/no_requirement" />
                        </RadioGroup>
                        <TextView style="@style/ActionForm.GroupTitle" android:text="@string/power_requirement" />
                        <RadioGroup android:id="@+id/rg_power_requirement" style="@style/Form.OptionGroup">
                            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_power_requirement_low" style="@style/Form.Option" android:checked="true" android:text="@string/power_requirement_low" />
                            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_power_requirement_medium" style="@style/Form.Option" android:text="@string/power_requirement_medium" />
                            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_power_requirement_high" style="@style/Form.Option" android:text="@string/power_requirement_high" />
                            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_power_requirement_no_requirement" style="@style/Form.Option" android:text="@string/no_requirement" />
                        </RadioGroup>
                        <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/action_form_min_interval" app:helperText="@string/action_form_min_interval_help">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_min_interval" android:layout_width="match_parent" android:layout_height="wrap_content" android:digits="0123456789" android:importantForAutofill="no" android:inputType="number" android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/action_form_min_distance" app:helperText="@string/action_form_min_distance_help">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_min_distance" android:layout_width="match_parent" android:layout_height="wrap_content" android:digits="0123456789" android:importantForAutofill="no" android:inputType="number" android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/Form.Subsection">
                    <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_enable_sms_command" style="@style/Form.SwitchRow" android:text="@string/sms_command" />
                    <TextView style="@style/Form.Supporting" android:text="@string/sms_command_tips" />
                    <LinearLayout style="@style/ActionForm.Nested">
                        <TextView style="@style/ActionForm.GroupTitle" android:text="@string/action_form_allowed_numbers" />
                        <TextView style="@style/Form.Supporting" android:text="@string/safe_phone_tips" />
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_safe_phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/safe_phone_tips" tools:ignore="TextContrastCheck,TouchTargetSizeCheck" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/Form.Subsection">
                    <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_enable_load_app_list" style="@style/Form.SwitchRow" android:text="@string/load_app_list" />
                    <TextView style="@style/Form.Supporting" android:text="@string/load_app_list_tips" />
                    <TextView style="@style/ActionForm.GroupTitle" android:text="@string/action_form_app_types" />
                    <LinearLayout style="@style/ActionForm.CheckGroup">
                        <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/scb_load_user_app" style="@style/Form.CheckRow" android:text="@string/user_app" app:scb_color_checked="@color/colorPrimary" />
                        <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/scb_load_system_app" style="@style/Form.CheckRow" android:text="@string/system_app" app:scb_color_checked="@color/colorPrimary" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/layout_app_list" style="@style/Form.Subsection">
                    <TextView style="@style/Form.GroupTitle" android:text="@string/action_form_dismiss_apps" />
                    <TextView style="@style/Form.Supporting" android:text="@string/extra_app_hint" />
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_app_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/extra_app_hint" android:inputType="textMultiLine" app:met_clearButton="true" tools:ignore="TextContrastCheck" />
                    <LinearLayout android:id="@+id/layout_sp_app" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:visibility="gone">
                        <cn.ppps.forwarder.widget.material.TargetEditDropdown android:id="@+id/sp_app" style="@style/Form.Dropdown" android:theme="@style/ThemeOverlay.Material3.AutoCompleteTextView.OutlinedBox" app:es_hint="@string/choose_app" app:es_maxLength="20" app:es_maxLine="1" app:helperText="@string/choose_app_hint" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/Form.Subsection">
                    <TextView style="@style/Form.GroupTitle" android:text="@string/filtering_duplicate_messages" />
                    <TextView style="@style/Form.Supporting" android:text="@string/filtering_duplicate_messages_tips" />
                    <TextView android:id="@+id/action_form_duplicate_value" style="@style/ActionForm.SliderValue" android:layout_marginTop="8dp" />
                    <cn.ppps.forwarder.widget.material.TargetSlider android:id="@+id/xsb_duplicate_messages_limits" style="@style/ActionForm.Slider" android:contentDescription="@string/filtering_duplicate_messages" app:xsb_max="120" app:xsb_min="0" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:padding="10dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_del" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_delete" android:text="@string/discard" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/MaterialActionButton" android:drawableStart="@drawable/ic_save" android:text="@string/m3_apply" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_test" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_test" android:text="@string/test" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
    </LinearLayout>
</LinearLayout>
