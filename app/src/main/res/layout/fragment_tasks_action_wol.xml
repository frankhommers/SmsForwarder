<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical" tools:context=".fragment.action.WolFragment">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never">
        <!-- Task-action form (ActionForm.* on top of the Form.* recipe, privacy-verification/form-pattern/PATTERN.md). Ids, view classes, defaults and show/hide logic unchanged. -->
        <LinearLayout style="@style/Form.Content">
            <androidx.appcompat.widget.AppCompatImageView style="@style/ActionForm.Hero" android:contentDescription="@string/task_wol" app:srcCompat="@drawable/auto_task_icon_wol" tools:ignore="ImageContrastCheck" />
            <LinearLayout style="@style/Form.Section.First">
                <TextView style="@style/Form.SectionTitle" android:text="@string/task_wol" />
                <TextView style="@style/Form.Supporting" android:text="@string/task_wol_tips" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/action_form_mac_address" app:helperText="@string/action_form_mac_help">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_mac" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" tools:ignore="TextContrastCheck" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/broadcast_address" app:helperText="@string/action_form_broadcast_help">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_ip" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" tools:ignore="TextContrastCheck" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/port" app:helperText="@string/action_form_port_help">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_port" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:value="9" tools:ignore="TextContrastCheck" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/wol_method" />
                <RadioGroup android:id="@+id/rg_wake_method" style="@style/Form.OptionGroup">
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_api" style="@style/Form.Option" android:checked="true" android:text="@string/wol_method_local_api" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_direct" style="@style/Form.Option" android:text="@string/wol_method_magic_packet" />
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:padding="10dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_del" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_delete" android:text="@string/discard" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/MaterialActionButton" android:drawableStart="@drawable/ic_save" android:text="@string/m3_apply" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_test" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_test" android:text="@string/test" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
    </LinearLayout>
</LinearLayout>
