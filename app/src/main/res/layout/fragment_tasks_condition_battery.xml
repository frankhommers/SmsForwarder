<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never">
        <!-- Condition form (ConditionForm.* on top of the Form.* recipe, privacy-verification/form-pattern/PATTERN.md). Each level slider has a visible value readout bound by BatteryFragment; range and storage unchanged. -->
        <LinearLayout style="@style/Form.Content">
            <androidx.appcompat.widget.AppCompatImageView style="@style/ConditionForm.Hero" android:contentDescription="@string/task_battery" app:srcCompat="@drawable/auto_task_icon_battery" tools:ignore="ImageContrastCheck" />
            <LinearLayout style="@style/Form.Section.First">
                <TextView style="@style/Form.SectionTitle" android:text="@string/task_battery" />
                <TextView android:id="@+id/tv_description" style="@style/Form.Supporting" android:text="@string/task_battery_tips" />
                <RadioGroup android:id="@+id/rg_status" style="@style/Form.OptionGroup" android:layout_marginTop="16dp">
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_battery_discharging" style="@style/Form.Option" android:checked="true" android:text="@string/discharged_to" />
                    <TextView android:id="@+id/condition_form_level_min_value" style="@style/ConditionForm.SliderValue" />
                    <cn.ppps.forwarder.widget.material.TargetSlider android:id="@+id/xsb_level_min" style="@style/ConditionForm.Slider" android:contentDescription="@string/discharged_to" app:xsb_max="100" app:xsb_min="1" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_battery_charging" style="@style/Form.Option" android:text="@string/charged_to" />
                    <TextView android:id="@+id/condition_form_level_max_value" style="@style/ConditionForm.SliderValue" android:visibility="gone" />
                    <cn.ppps.forwarder.widget.material.TargetSlider android:id="@+id/xsb_level_max" style="@style/ConditionForm.Slider" android:contentDescription="@string/charged_to" android:visibility="gone" app:xsb_max="100" app:xsb_min="1" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout style="@style/Form.Section">
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_keep_reminding" style="@style/Form.SwitchRow" android:text="@string/keep_reminding" />
                <TextView style="@style/Form.Supporting" android:text="@string/keep_reminding_tips" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:padding="10dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_del" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_delete" android:text="@string/discard" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/MaterialActionButton" android:drawableStart="@drawable/ic_save" android:text="@string/m3_apply" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
    </LinearLayout>
</LinearLayout>
