<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never">
        <!-- Condition form (ConditionForm.* on top of the Form.* recipe, privacy-verification/form-pattern/PATTERN.md). Nested state/result choices are stacked option rows; device address is a full-width labelled field. -->
        <LinearLayout style="@style/Form.Content">
            <androidx.appcompat.widget.AppCompatImageView style="@style/ConditionForm.Hero" android:contentDescription="@string/task_bluetooth" app:srcCompat="@drawable/auto_task_icon_bluetooth" tools:ignore="ImageContrastCheck" />
            <LinearLayout style="@style/Form.Section.First">
                <TextView style="@style/Form.SectionTitle" android:text="@string/task_bluetooth" />
                <TextView android:id="@+id/tv_description" style="@style/Form.Supporting" android:text="@string/task_bluetooth_tips" />
                <RadioGroup android:id="@+id/rg_bluetooth_action" style="@style/Form.OptionGroup" android:layout_marginTop="16dp">
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_action_state_changed" style="@style/Form.Option" android:checked="true" android:text="@string/bluetooth_state_changed" />
                    <LinearLayout android:id="@+id/layout_bluetooth_state" style="@style/ConditionForm.Nested">
                        <TextView style="@style/Form.GroupTitle" android:text="@string/specified_state" />
                        <RadioGroup android:id="@+id/rg_bluetooth_state" style="@style/Form.OptionGroup">
                            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_state_on" style="@style/Form.Option" android:checked="true" android:text="@string/state_on" />
                            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_state_off" style="@style/Form.Option" android:text="@string/state_off" />
                        </RadioGroup>
                    </LinearLayout>
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_action_discovery_finished" style="@style/Form.Option" android:text="@string/bluetooth_discovery_finished" />
                    <LinearLayout android:id="@+id/layout_discovery_finished" style="@style/ConditionForm.Nested" android:visibility="gone">
                        <TextView style="@style/Form.GroupTitle" android:text="@string/specified_result" />
                        <RadioGroup android:id="@+id/rg_discovery_result" style="@style/Form.OptionGroup">
                            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_discovered" style="@style/Form.Option" android:checked="true" android:text="@string/discovered" />
                            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_undiscovered" style="@style/Form.Option" android:text="@string/undiscovered" />
                        </RadioGroup>
                    </LinearLayout>
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_action_acl_connected" style="@style/Form.Option" android:text="@string/bluetooth_acl_connected" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_action_acl_disconnected" style="@style/Form.Option" android:text="@string/bluetooth_acl_disconnected" />
                </RadioGroup>
                <LinearLayout android:id="@+id/layout_device_address" style="@style/Form.Subsection" android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/specified_device" app:helperText="@string/mac_hint">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_device_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_start_discovery" style="@style/Form.Action" android:text="@string/start_discovery" />
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_devices" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:padding="10dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_del" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_delete" android:text="@string/discard" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/MaterialActionButton" android:drawableStart="@drawable/ic_save" android:text="@string/m3_apply" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
    </LinearLayout>
</LinearLayout>
