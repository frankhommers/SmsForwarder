<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never">
        <!-- Condition form (ConditionForm.* on top of Form.*): every checkbox is one full-width labelled row with a square
             MaterialCheckBox, so labels no longer break inside 28dp grid columns. Ids, defaults and listeners unchanged. -->
        <LinearLayout style="@style/Form.Content">
            <androidx.appcompat.widget.AppCompatImageView style="@style/ConditionForm.Hero" android:contentDescription="@string/task_charge" app:srcCompat="@drawable/auto_task_icon_charge" tools:ignore="ImageContrastCheck" />

            <LinearLayout style="@style/Form.Section.First">
                <TextView style="@style/Form.SectionTitle" android:text="@string/task_charge" />
                <TextView android:id="@+id/tv_description" style="@style/Form.Supporting" android:text="@string/task_charge_tips" />
            </LinearLayout>

            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/battery_status_title" />
                <LinearLayout style="@style/ConditionForm.CheckGroup">
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/cb_battery_charging" style="@style/Form.CheckRow" android:checked="true" android:text="@string/battery_charging" />
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/cb_battery_discharging" style="@style/Form.CheckRow" android:text="@string/battery_discharging" />
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/cb_battery_not_charging" style="@style/Form.CheckRow" android:text="@string/battery_not_charging" />
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/cb_battery_full" style="@style/Form.CheckRow" android:text="@string/battery_full" />
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/cb_battery_unknown" style="@style/Form.CheckRow" android:text="@string/condition_form_unknown" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/battery_plugged_title" />
                <LinearLayout style="@style/ConditionForm.CheckGroup">
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/cb_plugged_ac" style="@style/Form.CheckRow" android:text="@string/battery_ac" />
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/cb_plugged_usb" style="@style/Form.CheckRow" android:text="@string/battery_usb" />
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/cb_plugged_wireless" style="@style/Form.CheckRow" android:text="@string/battery_wireless" />
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/cb_plugged_unlimited" style="@style/Form.CheckRow" android:checked="true" android:text="@string/condition_form_any_power_source" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/battery_voltage_title" />
                <LinearLayout style="@style/ConditionForm.CheckGroup">
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/cb_voltage_unlimited" style="@style/Form.CheckRow" android:checked="true" android:text="@string/condition_form_no_voltage_limit" />
                </LinearLayout>
                <LinearLayout android:id="@+id/layout_voltage" style="@style/ConditionForm.Nested" android:visibility="gone">
                    <cn.ppps.forwarder.widget.material.TargetRangeSlider android:id="@+id/xrs_voltage" style="@style/ConditionForm.Slider" android:contentDescription="@string/battery_voltage_title" app:xrs_max="6000" app:xrs_min="2000" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/battery_temperature_title" />
                <LinearLayout style="@style/ConditionForm.CheckGroup">
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/cb_temperature_unlimited" style="@style/Form.CheckRow" android:checked="true" android:text="@string/condition_form_no_temperature_limit" />
                </LinearLayout>
                <LinearLayout android:id="@+id/layout_temperature" style="@style/ConditionForm.Nested" android:visibility="gone">
                    <cn.ppps.forwarder.widget.material.TargetRangeSlider android:id="@+id/xrs_temperature" style="@style/ConditionForm.Slider" android:contentDescription="@string/battery_temperature_title" app:xrs_max="80" app:xrs_min="-20" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/battery_health_title" />
                <LinearLayout style="@style/ConditionForm.CheckGroup">
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/cb_health_unlimited" style="@style/Form.CheckRow" android:checked="true" android:text="@string/condition_form_any_health" />
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/cb_health_good" style="@style/Form.CheckRow" android:text="@string/battery_good" />
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/cb_health_overheat" style="@style/Form.CheckRow" android:text="@string/battery_overheat" />
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/cb_health_cold" style="@style/Form.CheckRow" android:text="@string/battery_cold" />
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/cb_health_dead" style="@style/Form.CheckRow" android:text="@string/battery_dead" />
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/cb_health_over_voltage" style="@style/Form.CheckRow" android:text="@string/battery_over_voltage" />
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/cb_health_unspecified_failure" style="@style/Form.CheckRow" android:text="@string/battery_unspecified_failure" />
                    <cn.ppps.forwarder.widget.material.TargetCheckBox android:id="@+id/cb_health_unknown" style="@style/Form.CheckRow" android:text="@string/condition_form_unknown" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/condition_match_type_title" />
                <RadioGroup android:id="@+id/rg_match_type" style="@style/Form.OptionGroup">
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_match_all" style="@style/Form.Option" android:checked="true" android:text="@string/condition_match_all" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_match_any" style="@style/Form.Option" android:text="@string/condition_match_any" />
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:padding="10dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_del" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_delete" android:text="@string/discard" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/MaterialActionButton" android:drawableStart="@drawable/ic_save" android:text="@string/m3_apply" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
    </LinearLayout>
</LinearLayout>
