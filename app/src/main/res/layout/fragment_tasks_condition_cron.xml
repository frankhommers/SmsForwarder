                    </LinearLayout>
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_year_type_interval" style="@style/Form.Option" android:text="@string/interval" />
                    <LinearLayout style="@style/ConditionForm.Nested">
                        <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/editor_form_cron_start_at">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_year_interval_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:importantForAutofill="no" android:inputType="number" android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/editor_form_cron_every">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_year_interval" android:layout_width="match_parent" android:layout_height="wrap_content" android:importantForAutofill="no" android:inputType="number" android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_year_type_assigned" style="@style/Form.Option" android:text="@string/editor_form_cron_specific" />
                </RadioGroup>
                <cn.ppps.forwarder.widget.material.TargetChips android:id="@+id/flowlayout_multi_select_year" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
