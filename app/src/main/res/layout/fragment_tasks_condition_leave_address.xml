<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never">
        <!-- Address-keyword matching needs address lookup, which the app does not do: the option is disabled for new conditions and a saved one is shown as an unsupported legacy condition (LocationConditionEditor). -->
        <!-- Condition form (ConditionForm.* on top of the Form.* recipe, privacy-verification/form-pattern/PATTERN.md). Coordinates and radius are full-width labelled outlined fields; ids and listeners unchanged. -->
        <LinearLayout style="@style/Form.Content">
            <androidx.appcompat.widget.AppCompatImageView style="@style/ConditionForm.Hero" android:contentDescription="@string/task_leave_address" app:srcCompat="@drawable/auto_task_icon_leave_address" tools:ignore="ImageContrastCheck" />
            <LinearLayout style="@style/Form.Section.First">
                <TextView style="@style/Form.SectionTitle" android:text="@string/task_leave_address" />
                <TextView android:id="@+id/tv_description" style="@style/Form.Supporting" android:text="@string/task_leave_address_tips" />
            </LinearLayout>

            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/condition_form_detection_method" />
                <TextView android:id="@+id/condition_form_location_legacy_notice" style="@style/Form.Supporting" android:text="@string/location_validation_legacy_notice" android:textColor="?attr/colorError" android:visibility="gone" />
                <RadioGroup android:id="@+id/rg_calc_type" style="@style/Form.OptionGroup">
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_calc_type_distance" style="@style/Form.Option" android:checked="true" android:text="@string/calc_type_distance" />
                    <LinearLayout android:id="@+id/layout_calc_type_distance" style="@style/ConditionForm.Nested">
                        <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/longitude" app:helperText="@string/location_validation_longitude_help">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_longitude" android:layout_width="match_parent" android:layout_height="wrap_content" android:importantForAutofill="no" android:inputType="numberSigned|numberDecimal" tools:ignore="TextFields" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/latitude" app:helperText="@string/location_validation_latitude_help">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_latitude" android:layout_width="match_parent" android:layout_height="wrap_content" android:importantForAutofill="no" android:inputType="numberSigned|numberDecimal" tools:ignore="TextFields" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btn_current_coordinates" style="@style/Form.Action" android:text="@string/condition_form_use_current_location" />
                        <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/condition_form_radius" app:helperText="@string/condition_form_radius_help_leave">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_distance" android:layout_width="match_parent" android:layout_height="wrap_content" android:importantForAutofill="no" android:inputType="numberDecimal" tools:ignore="TextFields" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_calc_type_address" style="@style/Form.Option" android:enabled="false" android:text="@string/location_validation_address_option" />
                    <TextView android:id="@+id/condition_form_location_address_unavailable" style="@style/Form.Supporting" android:text="@string/location_validation_address_unavailable" />
                    <LinearLayout android:id="@+id/layout_calc_type_address" style="@style/ConditionForm.Nested" android:visibility="gone">
                        <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/keyword" app:helperText="@string/location_validation_address_saved">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:importantForAutofill="no" tools:ignore="TextFields" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:padding="10dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_del" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_delete" android:text="@string/discard" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/MaterialActionButton" android:drawableStart="@drawable/ic_save" android:text="@string/m3_apply" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
    </LinearLayout>
</LinearLayout>
