<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never">
        <!-- Condition form (ConditionForm.* on top of the Form.* recipe, privacy-verification/form-pattern/PATTERN.md). Each delay slider has a visible value readout bound by LockScreenFragment; range and storage unchanged. -->
        <LinearLayout style="@style/Form.Content">
            <androidx.appcompat.widget.AppCompatImageView style="@style/ConditionForm.Hero" android:contentDescription="@string/task_lock_screen" app:srcCompat="@drawable/auto_task_icon_lock_screen" tools:ignore="ImageContrastCheck" />
            <LinearLayout style="@style/Form.Section.First">
                <TextView style="@style/Form.SectionTitle" android:text="@string/task_lock_screen" />
                <TextView android:id="@+id/tv_description" style="@style/Form.Supporting" android:text="@string/task_lock_screen_tips" />
                <RadioGroup android:id="@+id/rg_action" style="@style/Form.OptionGroup" android:layout_marginTop="16dp">
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_action_screen_off" style="@style/Form.Option" android:checked="true" android:text="@string/time_after_screen_off" />
                    <TextView android:id="@+id/condition_form_screen_off_value" style="@style/ConditionForm.SliderValue" />
                    <cn.ppps.forwarder.widget.material.TargetSlider android:id="@+id/xsb_time_after_screen_off" style="@style/ConditionForm.Slider" android:contentDescription="@string/time_after_screen_off" app:xsb_max="30" app:xsb_min="0" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_action_screen_locked" style="@style/Form.Option" android:text="@string/time_after_screen_locked" />
                    <TextView android:id="@+id/condition_form_screen_locked_value" style="@style/ConditionForm.SliderValue" android:visibility="gone" />
                    <cn.ppps.forwarder.widget.material.TargetSlider android:id="@+id/xsb_time_after_screen_locked" style="@style/ConditionForm.Slider" android:contentDescription="@string/time_after_screen_locked" android:visibility="gone" app:xsb_max="30" app:xsb_min="0" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_action_screen_on" style="@style/Form.Option" android:text="@string/time_after_screen_on" />
                    <TextView android:id="@+id/condition_form_screen_on_value" style="@style/ConditionForm.SliderValue" android:visibility="gone" />
                    <cn.ppps.forwarder.widget.material.TargetSlider android:id="@+id/xsb_time_after_screen_on" style="@style/ConditionForm.Slider" android:contentDescription="@string/time_after_screen_on" android:visibility="gone" app:xsb_max="30" app:xsb_min="0" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_action_screen_unlocked" style="@style/Form.Option" android:text="@string/time_after_screen_unlocked" />
                    <TextView android:id="@+id/condition_form_screen_unlocked_value" style="@style/ConditionForm.SliderValue" android:visibility="gone" />
                    <cn.ppps.forwarder.widget.material.TargetSlider android:id="@+id/xsb_time_after_screen_unlocked" style="@style/ConditionForm.Slider" android:contentDescription="@string/time_after_screen_unlocked" android:visibility="gone" app:xsb_max="30" app:xsb_min="0" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout android:id="@+id/layout_check_again" style="@style/Form.Section">
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_check_again" style="@style/Form.SwitchRow" android:text="@string/task_condition_check_again" />
                <TextView style="@style/Form.Supporting" android:text="@string/task_condition_check_again_tips" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:padding="10dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_del" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_delete" android:text="@string/discard" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/MaterialActionButton" android:drawableStart="@drawable/ic_save" android:text="@string/m3_apply" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
    </LinearLayout>
</LinearLayout>
