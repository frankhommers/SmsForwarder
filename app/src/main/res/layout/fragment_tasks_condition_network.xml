<?xml version="1.0" encoding="utf-8"?>
<!-- Condition form (ConditionForm.* on top of the Form.* recipe, privacy-verification/form-pattern/PATTERN.md). Stacked 48dp option rows at the 16dp keyline; the Wi-Fi name is a full-width labelled field. Ids, view classes, defaults and NetworkFragment show/hide logic unchanged. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never">
        <LinearLayout style="@style/Form.Content">
            <androidx.appcompat.widget.AppCompatImageView style="@style/ConditionForm.Hero" android:contentDescription="@string/task_network" app:srcCompat="@drawable/auto_task_icon_network" tools:ignore="ImageContrastCheck" />
            <LinearLayout style="@style/Form.Section.First">
                <TextView style="@style/Form.SectionTitle" android:text="@string/task_network" />
                <TextView android:id="@+id/tv_description" style="@style/Form.Supporting" android:text="@string/task_network_tips" />
                <RadioGroup android:id="@+id/rg_network_state" style="@style/Form.OptionGroup" android:layout_marginTop="16dp">
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_no_network" style="@style/Form.Option" android:checked="true" android:text="@string/no_network" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_net_mobile" style="@style/Form.Option" android:text="@string/net_mobile" />
                    <LinearLayout android:id="@+id/layout_data_sim_slot" style="@style/ConditionForm.Nested" android:visibility="gone">
                        <TextView style="@style/Form.GroupTitle" android:text="@string/data_sim_index" />
                        <RadioGroup android:id="@+id/rg_data_sim_slot" style="@style/Form.OptionGroup">
                            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_data_sim_slot_0" style="@style/Form.Option" android:checked="true" android:text="@string/sim_any" />
                            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_data_sim_slot_1" style="@style/Form.Option" android:text="@string/sim_1" />
                            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_data_sim_slot_2" style="@style/Form.Option" android:text="@string/sim_2" />
                        </RadioGroup>
                    </LinearLayout>
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_net_wifi" style="@style/Form.Option" android:text="@string/net_wifi" />
                    <LinearLayout android:id="@+id/layout_wifi_ssid" style="@style/ConditionForm.Nested" android:visibility="gone">
                        <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/wifi_ssid" app:helperText="@string/wifi_ssid_hint">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_wifi_ssid" android:layout_width="match_parent" android:layout_height="wrap_content" android:importantForAutofill="no" android:singleLine="true" tools:ignore="TextFields" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_net_ethernet" style="@style/Form.Option" android:text="@string/net_ethernet" android:visibility="gone" />
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rb_net_unknown" style="@style/Form.Option" android:text="@string/net_unknown" android:visibility="gone" tools:ignore="DuplicateSpeakableTextCheck" />
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:padding="10dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_del" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_delete" android:text="@string/discard" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/MaterialActionButton" android:drawableStart="@drawable/ic_save" android:text="@string/m3_apply" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
    </LinearLayout>
</LinearLayout>
