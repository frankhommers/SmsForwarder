<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/xui_config_color_background" android:orientation="vertical">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never">
        <!-- Task-action form (ActionForm.* on top of the Form.* recipe, privacy-verification/form-pattern/PATTERN.md). Ids, view classes, defaults and show/hide logic unchanged. -->
        <LinearLayout style="@style/Form.Content">
            <LinearLayout style="@style/Form.Section.First">
                <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:hint="@string/action_form_task_name">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" tools:ignore="VisualLintTextFieldSize" />
                </com.google.android.material.textfield.TextInputLayout>
                <cn.ppps.forwarder.widget.material.TargetSwitch android:id="@+id/sb_status" style="@style/Form.SwitchRow" android:layout_marginTop="8dp" android:checked="true" android:text="@string/action_form_task_enabled" />
            </LinearLayout>
            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/task_conditions" />
                <TextView style="@style/Form.Supporting" android:text="@string/task_conditions_tips" />
                <LinearLayout android:id="@+id/layout_conditions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_conditions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                <LinearLayout android:id="@+id/layout_add_condition" style="@style/ActionForm.AddRow">
                    <ImageView style="@style/ActionForm.AddIcon" android:src="@drawable/ic_add" app:tint="?attr/colorPrimary" tools:ignore="ContentDescription" />
                    <LinearLayout style="@style/ActionForm.AddText">
                        <TextView android:id="@+id/tv_add_condition" style="@style/ActionForm.AddTitle" android:text="@string/add_condition" />
                        <TextView android:id="@+id/tv_add_condition_tips" style="@style/ActionForm.AddSupporting" android:text="@string/add_condition_tips" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout style="@style/Form.Section">
                <TextView style="@style/Form.SectionTitle" android:text="@string/task_actions" />
                <TextView style="@style/Form.Supporting" android:text="@string/task_actions_tips" />
                <LinearLayout android:id="@+id/layout_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                <LinearLayout android:id="@+id/layout_add_action" style="@style/ActionForm.AddRow">
                    <ImageView style="@style/ActionForm.AddIcon" android:src="@drawable/ic_add" app:tint="?attr/colorPrimary" tools:ignore="ContentDescription" />
                    <LinearLayout style="@style/ActionForm.AddText">
                        <TextView android:id="@+id/tv_add_action" style="@style/ActionForm.AddTitle" android:text="@string/add_action" />
                        <TextView android:id="@+id/tv_add_action_tips" style="@style/ActionForm.AddSupporting" android:text="@string/add_action_tips" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:padding="10dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_del" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_delete" android:text="@string/del" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/MaterialActionButton" android:drawableStart="@drawable/ic_save" android:text="@string/save" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_test" style="@style/MaterialActionButton.Secondary" android:drawableStart="@drawable/ic_test" android:text="@string/test" android:visibility="gone" tools:ignore="RtlSymmetry,TextContrastCheck,TouchTargetSizeCheck" />
    </LinearLayout>
</LinearLayout>
