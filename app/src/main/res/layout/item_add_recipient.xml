<?xml version="1.0" encoding="utf-8"?>
<!--
  One recipient of the Email target (EmailFragment.addRecipientItem). Inflated with a null parent, so it uses padding,
  not margins: 16dp above each row. Address + 48dp remove icon on one line; the certificate block (S/MIME, OpenPGP)
  is full width below it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="16dp">
    <LinearLayout style="@style/Form.HelpRow">
        <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field" android:layout_width="0dp" android:layout_weight="1" android:hint="@string/recipient_email">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_recipient_email" android:inputType="textEmailAddress" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
        <ImageView android:id="@+id/iv_del" style="@style/TargetForm.IconAction.Field" android:contentDescription="@string/target_form_remove_recipient" android:src="@drawable/ic_delete" app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
    <LinearLayout android:id="@+id/layout_recipient_keystore" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/keystore_base64" app:helperText="@string/target_form_key_file_helper">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_recipient_keystore" android:gravity="start|top" android:importantForAutofill="no" android:inputType="textMultiLine" android:maxLines="5" android:minLines="2" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_file_picker" style="@style/Form.Action" android:text="@string/select_file" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Form.Field.Next" android:hint="@string/keystore_password" app:endIconMode="password_toggle" app:helperText="@string/target_form_recipient_key_password_helper">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_recipient_password" android:importantForAutofill="no" android:inputType="textPassword" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</LinearLayout>
