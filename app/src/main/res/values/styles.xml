<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Extended theme theme. -->
    <style name="XUITheme" parent="XUIBaseTheme" tools:ignore="PrivateResource">
        <!--Sets the animation style of the default window-->
        <item name="android:windowAnimationStyle">@style/WindowAnimStyle</item>
    </style>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">@bool/m3_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/m3_light_system_bars</item>
        <item name="xui_config_color_background">?attr/colorSurface</item>
        <item name="xui_config_color_separator_light">?attr/colorOutlineVariant</item>
        <item name="xui_config_color_content_text">?attr/colorOnSurface</item>
        <item name="xui_config_color_title_text">?attr/colorOnSurface</item>
        <item name="xui_config_color_explain_text">?attr/colorOnSurfaceVariant</item>
        <item name="xui_config_content_spacing_horizontal">16dp</item>
        <item name="xui_config_size_content_text">16sp</item>
        <item name="xui_config_size_title_text">20sp</item>
        <item name="xui_config_size_explain_text">14sp</item>
        <item name="colorPrimaryDark">?attr/colorSurface</item>
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="xui_actionbar_height">?actionBarSize</item>
        <!-- Solve Android 5.1 and above Button Question of automatic capitalisation of English string -->
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="AppTheme.Launch" parent="AppTheme" />

    <!--Form background. This background can be displayed at the first time., Avoid white screen startup, blackscreen problem-->
    <style name="AppTheme.Launch.App" parent="AppTheme" />

    <!--DialogTheme，For use withActivityAsDialogTheme-->
    <style name="DialogTheme" parent="AppTheme">
        <!--Settingsdialog, the transparency value given here for the system-->
        <item name="android:windowBackground">@android:color/transparent</item>
        <!--DialogofwindowFrameBox None-->
        <item name="android:windowFrame">@null</item>
        <!--Untitled-->
        <item name="android:windowNoTitle">true</item>
        <!--Is it floating now?activityUp-->
        <item name="android:windowIsFloating" tools:ignore="TranslucentOrientation">true</item>
        <!--Translucency-->
        <item name="android:windowIsTranslucent">true</item>
        <!--Whether to overlay-->
        <item name="android:windowContentOverlay">@null</item>
        <!--SettingsActivityForm of appearance-->
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <!--Whether the background is blurry-->
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="SuperButton.Gray.Icon.Spacing">
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
    </style>

    <style name="SuperButton.Blue.Icon.Spacing">
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
    </style>

    <style name="SuperButton.Green.Icon.Spacing">
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
    </style>

</resources>
